<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Appium.WebDriver" Version="5.2.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.15" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.2" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit.Analyzers" Version="3.10.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Selenium.Support" Version="4.52.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\OpenKSeF.Mobile\Models\*.cs" Exclude="..\OpenKSeF.Mobile\Models\CachedInvoice.cs" Link="Linked\Models\%(Filename)%(Extension)" />
    <Compile Include="..\OpenKSeF.Mobile\ViewModels\IssuingFormat.cs" Link="Linked\ViewModels\IssuingFormat.cs" />
    <Compile Include="..\OpenKSeF.Mobile\Services\IssuedInvoiceTotals.cs" Link="Linked\Services\IssuedInvoiceTotals.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenKSeF.Mobile.E2E.Shared\OpenKSeF.Mobile.E2E.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.Test.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
