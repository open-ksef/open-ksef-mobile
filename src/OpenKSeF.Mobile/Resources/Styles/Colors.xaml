<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Brand -->
    <Color x:Key="Primary">#6366f1</Color>
    <Color x:Key="PrimaryHover">#4f46e5</Color>
    <Color x:Key="PrimarySubtle">#eef2ff</Color>
    <Color x:Key="PrimaryDark">#818cf8</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#DFD8F7</Color>
    <Color x:Key="SecondaryDarkText">#9880E5</Color>
    <Color x:Key="Tertiary">#2B0B98</Color>

    <!-- Auth gradient -->
    <Color x:Key="GradientStart">#1e1b4b</Color>
    <Color x:Key="GradientMid">#312e81</Color>
    <Color x:Key="GradientEnd">#4338ca</Color>

    <!-- Status -->
    <Color x:Key="Success">#059669</Color>
    <Color x:Key="SuccessBg">#d1fae5</Color>
    <Color x:Key="Warning">#d97706</Color>
    <Color x:Key="WarningBg">#fef3c7</Color>
    <Color x:Key="WarningText">#664D03</Color>
    <Color x:Key="Error">#dc2626</Color>
    <Color x:Key="ErrorBg">#fee2e2</Color>
    <Color x:Key="ErrorBorder">#fca5a5</Color>

    <!-- Surfaces -->
    <Color x:Key="Background">#f4f6f9</Color>
    <Color x:Key="Surface">#ffffff</Color>
    <Color x:Key="SurfaceHover">#f9fafb</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#111827</Color>
    <Color x:Key="TextMuted">#6b7280</Color>
    <Color x:Key="TextInverse">#f8fafc</Color>

    <!-- Info callout -->
    <Color x:Key="InfoBg">#f0f9ff</Color>
    <Color x:Key="InfoText">#1e40af</Color>
    <Color x:Key="InfoBorder">#bfdbfe</Color>

    <!-- Border -->
    <Color x:Key="Border">#e5e7eb</Color>

    <!-- Standard palette -->
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}" />
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}" />
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}" />
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}" />
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}" />
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}" />
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}" />
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}" />

    <!-- Design system v1 (issuing pages) -->
    <Color x:Key="UiBg">#f4f6f9</Color>
    <Color x:Key="UiBgDark">#0b0d17</Color>
    <Color x:Key="UiSurface">#ffffff</Color>
    <Color x:Key="UiSurfaceDark">#151827</Color>
    <Color x:Key="UiSurface2">#f9fafb</Color>
    <Color x:Key="UiSurface2Dark">#1c2033</Color>
    <Color x:Key="UiBorder">#e5e7eb</Color>
    <Color x:Key="UiBorderDark">#2a2f45</Color>
    <Color x:Key="UiBorderStrong">#d1d5db</Color>
    <Color x:Key="UiBorderStrongDark">#3a4060</Color>
    <Color x:Key="UiText">#111827</Color>
    <Color x:Key="UiTextDark">#e5e7eb</Color>
    <Color x:Key="UiMuted">#5b6474</Color>
    <Color x:Key="UiMutedDark">#a1a7b8</Color>
    <Color x:Key="UiPrimary">#4f46e5</Color>
    <Color x:Key="UiPrimaryDark">#818cf8</Color>
    <Color x:Key="UiPrimaryHover">#4338ca</Color>
    <Color x:Key="UiPrimaryHoverDark">#a5b4fc</Color>
    <Color x:Key="UiOnPrimary">#ffffff</Color>
    <Color x:Key="UiOnPrimaryDark">#11132a</Color>
    <Color x:Key="UiPrimarySubtle">#eef2ff</Color>
    <Color x:Key="UiPrimarySubtleDark">#232657</Color>
    <Color x:Key="UiAccent">#6366f1</Color>
    <Color x:Key="UiAccentDark">#818cf8</Color>
    <Color x:Key="UiFocus">#6366f1</Color>
    <Color x:Key="UiFocusDark">#a5b4fc</Color>
    <Color x:Key="UiSuccess">#047857</Color>
    <Color x:Key="UiSuccessDark">#34d399</Color>
    <Color x:Key="UiSuccessBg">#d1fae5</Color>
    <Color x:Key="UiSuccessBgDark">#0c2f25</Color>
    <Color x:Key="UiWarning">#b45309</Color>
    <Color x:Key="UiWarningDark">#fbbf24</Color>
    <Color x:Key="UiWarningBg">#fef3c7</Color>
    <Color x:Key="UiWarningBgDark">#33260a</Color>
    <Color x:Key="UiError">#b91c1c</Color>
    <Color x:Key="UiErrorDark">#f87171</Color>
    <Color x:Key="UiErrorBg">#fee2e2</Color>
    <Color x:Key="UiErrorBgDark">#3a1414</Color>
    <Color x:Key="UiOnError">#ffffff</Color>
    <Color x:Key="UiOnErrorDark">#2a0a0a</Color>
    <Color x:Key="UiInfo">#1d4ed8</Color>
    <Color x:Key="UiInfoDark">#60a5fa</Color>
    <Color x:Key="UiInfoBg">#dbeafe</Color>
    <Color x:Key="UiInfoBgDark">#10264a</Color>
    <Color x:Key="UiNeutral">#374151</Color>
    <Color x:Key="UiNeutralDark">#cbd5e1</Color>
    <Color x:Key="UiNeutralBg">#f3f4f6</Color>
    <Color x:Key="UiNeutralBgDark">#252a3d</Color>

</ResourceDictionary>
