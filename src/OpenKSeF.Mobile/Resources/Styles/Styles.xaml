<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:OpenKSeF.Mobile.ViewModels">

    <toolkit:IsNotNullConverter x:Key="IsNotNullConverter" />
    <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />

    <!-- ─── Page ─────────────────────────────────────────────── -->
    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource UiBg}, Dark={StaticResource UiBgDark}}" />
    </Style>

    <!-- ─── Shell ────────────────────────────────────────────── -->
    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource UiSurface}, Dark={StaticResource UiSurfaceDark}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource UiPrimary}, Dark={StaticResource UiPrimaryDark}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource UiText}, Dark={StaticResource UiTextDark}}" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource UiSurface}, Dark={StaticResource UiSurfaceDark}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource UiPrimary}, Dark={StaticResource UiPrimaryDark}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource UiMuted}, Dark={StaticResource UiMutedDark}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource UiPrimary}, Dark={StaticResource UiPrimaryDark}}" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{AppThemeBinding Light={StaticResource UiPrimary}, Dark={StaticResource UiPrimaryDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource UiSurface}, Dark={StaticResource UiSurfaceDark}}" />
    </Style>

    <!-- ─── Label (implicit) ─────────────────────────────────── -->
    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UiText}, Dark={StaticResource UiTextDark}}" />
    </Style>

    <!-- ─── Label variants ───────────────────────────────────── -->
    <Style x:Key="LabelMuted" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UiMuted}, Dark={StaticResource UiMutedDark}}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="LabelHeading" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UiText}, Dark={StaticResource UiTextDark}}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontFamily" Value="InterBold" />
    </Style>

    <Style x:Key="LabelCaption" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UiMuted}, Dark={StaticResource UiMutedDark}}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="LabelFormLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UiMuted}, Dark={StaticResource UiMutedDark}}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ─── Entry (implicit) ─────────────────────────────────── -->
    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UiText}, Dark={StaticResource UiTextDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource UiMuted}, Dark={StaticResource UiMutedDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource UiSurface}, Dark={StaticResource UiSurfaceDark}}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UiText}, Dark={StaticResource UiTextDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource UiMuted}, Dark={StaticResource UiMutedDark}}" />
        <Setter Property="CancelButtonColor" Value="{AppThemeBinding Light={StaticResource UiMuted}, Dark={StaticResource UiMutedDark}}" />
        <Setter Property="SearchIconColor" Value="{AppThemeBinding Light={StaticResource UiMuted}, Dark={StaticResource UiMutedDark}}" />
    </Style>

    <!-- ─── Editor (implicit) ────────────────────────────────── -->
    <Style TargetType="Editor">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UiText}, Dark={StaticResource UiTextDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource UiMuted}, Dark={StaticResource UiMutedDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource UiSurface}, Dark={StaticResource UiSurfaceDark}}" />
    </Style>

    <!-- ─── Button (implicit: primary filled) ────────────────── -->
    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource UiPrimary}, Dark={StaticResource UiPrimaryDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UiOnPrimary}, Dark={StaticResource UiOnPrimaryDark}}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="HeightRequest" Value="48" />
    </Style>

    <Style x:Key="ButtonSecondary" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource UiSurface}, Dark={StaticResource UiSurfaceDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UiPrimary}, Dark={StaticResource UiPrimaryDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource UiPrimary}, Dark={StaticResource UiPrimaryDark}}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="HeightRequest" Value="48" />
    </Style>

    <Style x:Key="ButtonOutline" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource UiSurface}, Dark={StaticResource UiSurfaceDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UiText}, Dark={StaticResource UiTextDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource UiBorderStrong}, Dark={StaticResource UiBorderStrongDark}}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="HeightRequest" Value="48" />
    </Style>

    <Style x:Key="ButtonGhost" TargetType="Button">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UiMuted}, Dark={StaticResource UiMutedDark}}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HeightRequest" Value="48" />
    </Style>

    <Style x:Key="ButtonSmall" TargetType="Button">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource UiPrimary}, Dark={StaticResource UiPrimaryDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UiOnPrimary}, Dark={StaticResource UiOnPrimaryDark}}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HeightRequest" Value="36" />
    </Style>

    <!-- ─── ActivityIndicator ────────────────────────────────── -->
    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource UiPrimary}, Dark={StaticResource UiPrimaryDark}}" />
    </Style>

    <!-- ─── Border card style ────────────────────────────────── -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource UiBorder}, Dark={StaticResource UiBorderDark}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource UiSurface}, Dark={StaticResource UiSurfaceDark}}" />
        <Setter Property="Padding" Value="15" />
    </Style>

    <!-- ─── Frame card style ─────────────────────────────────── -->
    <!-- ─── Design tokens ────────────────────────────────────── -->
    <Style x:Key="UiPage" TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource UiBg}, Dark={StaticResource UiBgDark}}" />
    </Style>

    <Style x:Key="UiCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource UiSurface}, Dark={StaticResource UiSurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource UiBorder}, Dark={StaticResource UiBorderDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="UiAlert" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <Style x:Key="UiDisplay" TargetType="Label">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontFamily" Value="InterBold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UiText}, Dark={StaticResource UiTextDark}}" />
    </Style>

    <Style x:Key="UiH2" TargetType="Label">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UiText}, Dark={StaticResource UiTextDark}}" />
    </Style>

    <Style x:Key="UiBody" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UiText}, Dark={StaticResource UiTextDark}}" />
    </Style>

    <Style x:Key="UiMutedText" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UiMuted}, Dark={StaticResource UiMutedDark}}" />
    </Style>

    <Style x:Key="UiFieldLabel" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UiText}, Dark={StaticResource UiTextDark}}" />
    </Style>

    <Style x:Key="UiCaption" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="CharacterSpacing" Value="0.5" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UiMuted}, Dark={StaticResource UiMutedDark}}" />
    </Style>

    <Style x:Key="UiFieldError" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UiError}, Dark={StaticResource UiErrorDark}}" />
    </Style>

    <Style x:Key="UiMono" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="JetBrainsMono" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UiText}, Dark={StaticResource UiTextDark}}" />
    </Style>

    <Style x:Key="UiEntry" TargetType="Entry">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UiText}, Dark={StaticResource UiTextDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource UiMuted}, Dark={StaticResource UiMutedDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource UiSurface}, Dark={StaticResource UiSurfaceDark}}" />
    </Style>

    <Style x:Key="UiEntryReadOnly" TargetType="Entry" BasedOn="{StaticResource UiEntry}">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UiMuted}, Dark={StaticResource UiMutedDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource UiSurface2}, Dark={StaticResource UiSurface2Dark}}" />
    </Style>

    <Style x:Key="UiPicker" TargetType="Picker">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UiText}, Dark={StaticResource UiTextDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource UiSurface}, Dark={StaticResource UiSurfaceDark}}" />
    </Style>

    <Style x:Key="UiDatePicker" TargetType="DatePicker">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="Format" Value="dd.MM.yyyy" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UiText}, Dark={StaticResource UiTextDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource UiSurface}, Dark={StaticResource UiSurfaceDark}}" />
    </Style>

    <Style x:Key="UiButtonPrimary" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource UiPrimary}, Dark={StaticResource UiPrimaryDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UiOnPrimary}, Dark={StaticResource UiOnPrimaryDark}}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="UiButtonOutline" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource UiSurface}, Dark={StaticResource UiSurfaceDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UiText}, Dark={StaticResource UiTextDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource UiBorderStrong}, Dark={StaticResource UiBorderStrongDark}}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="HeightRequest" Value="48" />
    </Style>

    <Style x:Key="UiButtonTonal" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource UiPrimarySubtle}, Dark={StaticResource UiPrimarySubtleDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UiPrimary}, Dark={StaticResource UiPrimaryDark}}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="HeightRequest" Value="48" />
    </Style>

    <Style x:Key="UiButtonGhost" TargetType="Button">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UiPrimary}, Dark={StaticResource UiPrimaryDark}}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HeightRequest" Value="48" />
    </Style>

    <!-- Native Switch tints are resolved once at creation, so a live theme switch left a track in the old theme's colour. -->
    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{AppThemeBinding Light={StaticResource UiPrimaryDark}, Dark={StaticResource UiPrimary}}" />
        <Setter Property="OffColor" Value="{AppThemeBinding Light={StaticResource UiBorderStrong}, Dark={StaticResource UiBorderStrongDark}}" />
        <Setter Property="ThumbColor" Value="{AppThemeBinding Light={StaticResource UiMuted}, Dark={StaticResource UiMutedDark}}" />
        <Style.Triggers>
            <Trigger TargetType="Switch" Property="IsToggled" Value="True">
                <Setter Property="ThumbColor" Value="{AppThemeBinding Light={StaticResource UiPrimary}, Dark={StaticResource UiPrimaryDark}}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="UiSegmentTrack" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource UiNeutralBg}, Dark={StaticResource UiNeutralBgDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <ControlTemplate x:Key="UiSegmentTemplate">
        <Border x:Name="Root" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,10" BackgroundColor="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CheckedStates">
                        <VisualState x:Name="Checked">
                            <VisualState.Setters>
                                <Setter TargetName="Root" Property="Border.BackgroundColor" Value="{AppThemeBinding Light={StaticResource UiSurface}, Dark={StaticResource UiSurfaceDark}}" />
                                <Setter TargetName="Text" Property="Label.FontFamily" Value="InterSemiBold" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Unchecked" />
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>
            <Label x:Name="Text" Text="{Binding Content, Source={RelativeSource TemplatedParent}}" FontSize="14"
                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource UiText}, Dark={StaticResource UiTextDark}}" />
        </Border>
    </ControlTemplate>

    <Style x:Key="UiSegment" TargetType="RadioButton">
        <Setter Property="ControlTemplate" Value="{StaticResource UiSegmentTemplate}" />
    </Style>

    <ControlTemplate x:Key="UiChipTemplate">
        <Border x:Name="Root" StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="14,8"
                Stroke="{AppThemeBinding Light={StaticResource UiBorderStrong}, Dark={StaticResource UiBorderStrongDark}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource UiSurface}, Dark={StaticResource UiSurfaceDark}}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CheckedStates">
                        <VisualState x:Name="Checked">
                            <VisualState.Setters>
                                <Setter TargetName="Root" Property="Border.BackgroundColor" Value="{AppThemeBinding Light={StaticResource UiPrimarySubtle}, Dark={StaticResource UiPrimarySubtleDark}}" />
                                <Setter TargetName="Root" Property="Border.Stroke" Value="{AppThemeBinding Light={StaticResource UiPrimary}, Dark={StaticResource UiPrimaryDark}}" />
                                <Setter TargetName="Text" Property="Label.TextColor" Value="{AppThemeBinding Light={StaticResource UiPrimary}, Dark={StaticResource UiPrimaryDark}}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Unchecked" />
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>
            <Label x:Name="Text" Text="{Binding Content, Source={RelativeSource TemplatedParent}}" FontSize="14"
                   VerticalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource UiText}, Dark={StaticResource UiTextDark}}" />
        </Border>
    </ControlTemplate>

    <Style x:Key="UiChip" TargetType="RadioButton">
        <Setter Property="ControlTemplate" Value="{StaticResource UiChipTemplate}" />
    </Style>

    <ControlTemplate x:Key="UiFilterChipTemplate">
        <Grid MinimumHeightRequest="48" BackgroundColor="Transparent">
            <Border x:Name="Root" HeightRequest="32" VerticalOptions="Center" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12,0"
                    Stroke="{AppThemeBinding Light={StaticResource UiBorderStrong}, Dark={StaticResource UiBorderStrongDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource UiSurface}, Dark={StaticResource UiSurfaceDark}}">
                <Label x:Name="Text" Text="{Binding Content, Source={RelativeSource TemplatedParent}}" FontSize="14" MinimumWidthRequest="24" HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource UiText}, Dark={StaticResource UiTextDark}}" />
            </Border>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CheckedStates">
                        <VisualState x:Name="Checked">
                            <VisualState.Setters>
                                <Setter TargetName="Root" Property="Border.BackgroundColor" Value="{AppThemeBinding Light={StaticResource UiPrimarySubtle}, Dark={StaticResource UiPrimarySubtleDark}}" />
                                <Setter TargetName="Root" Property="Border.Stroke" Value="{AppThemeBinding Light={StaticResource UiPrimary}, Dark={StaticResource UiPrimaryDark}}" />
                                <Setter TargetName="Text" Property="Label.TextColor" Value="{AppThemeBinding Light={StaticResource UiPrimary}, Dark={StaticResource UiPrimaryDark}}" />
                                <Setter TargetName="Text" Property="Label.FontFamily" Value="InterSemiBold" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Unchecked" />
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <Style x:Key="UiFilterChip" TargetType="RadioButton">
        <Setter Property="ControlTemplate" Value="{StaticResource UiFilterChipTemplate}" />
    </Style>

    <Style x:Key="UiIconButton" TargetType="ImageButton">
        <Setter Property="WidthRequest" Value="48" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style x:Key="UiOptionCard" TargetType="RadioButton">
        <Setter Property="ControlTemplate" Value="{StaticResource UiChipTemplate}" />
        <Setter Property="MinimumHeightRequest" Value="52" />
    </Style>


    <DataTemplate x:Key="TransferRowTemplate" x:DataType="vm:TransferFieldRow">
        <Border x:Name="TransferRow"
                StrokeThickness="0"
                StrokeShape="Rectangle"
                BackgroundColor="Transparent"
                MinimumHeightRequest="56"
                Padding="16,8,0,8"
                AutomationId="{Binding AutomationId}"
                SemanticProperties.Description="{Binding Description}"
                SemanticProperties.Hint="{Binding Hint}">
            <Border.Behaviors>
                <toolkit:TouchBehavior BindingContext="{Binding BindingContext, Source={x:Reference TransferRow}, x:DataType=Border}"
                                       IsEnabled="{Binding IsCopyable}"
                                       Command="{Binding CopyCommand}"
                                       LongPressCommand="{Binding LongPressCommand}"
                                       PressedOpacity="0.6" />
            </Border.Behaviors>
            <Border.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding IsCopied}" Value="True">
                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource UiPrimarySubtle}, Dark={StaticResource UiPrimarySubtleDark}}" />
                </DataTrigger>
            </Border.Triggers>
            <Grid ColumnDefinitions="*,48" RowDefinitions="Auto,Auto" RowSpacing="2">
                <BoxView x:Name="AccentInk" IsVisible="False" Color="{AppThemeBinding Light={StaticResource UiAccent}, Dark={StaticResource UiAccentDark}}" />
                <BoxView x:Name="SuccessInk" IsVisible="False" Color="{AppThemeBinding Light={StaticResource UiSuccess}, Dark={StaticResource UiSuccessDark}}" />
                <Label Text="{Binding Caption}"
                       Style="{StaticResource LabelCaption}"
                       AutomationProperties.IsInAccessibleTree="False" />
                <Label Grid.Row="1"
                       Text="{Binding Value}"
                       FontSize="16"
                       FontFamily="InterSemiBold"
                       LineBreakMode="WordWrap"
                       AutomationProperties.IsInAccessibleTree="False" />
                <Image Grid.Column="1" Grid.RowSpan="2"
                       Source="icon_copy.png"
                       WidthRequest="24" HeightRequest="24"
                       IsVisible="{Binding ShowCopyIcon}"
                       AutomationProperties.IsInAccessibleTree="False">
                    <Image.Behaviors>
                        <toolkit:IconTintColorBehavior x:DataType="BoxView" TintColor="{Binding Color, Source={x:Reference AccentInk}}" />
                    </Image.Behaviors>
                </Image>
                <Image Grid.Column="1" Grid.RowSpan="2"
                       Source="icon_check.png"
                       WidthRequest="24" HeightRequest="24"
                       IsVisible="{Binding IsCopied}"
                       AutomationProperties.IsInAccessibleTree="False">
                    <Image.Behaviors>
                        <toolkit:IconTintColorBehavior x:DataType="BoxView" TintColor="{Binding Color, Source={x:Reference SuccessInk}}" />
                    </Image.Behaviors>
                </Image>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
