<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OpenKSeF.Mobile.ViewModels"
             xmlns:models="clr-namespace:OpenKSeF.Mobile.Models"
             x:Class="OpenKSeF.Mobile.Views.InvoiceDetailsPage"
             x:DataType="vm:InvoiceDetailsViewModel"
             Title="Szczegóły faktury">

    <ScrollView>
        <Grid>
            <!-- Loading -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />

            <!-- Error -->
            <VerticalStackLayout IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="10"
                                 Padding="30">
                <Label Text="{Binding ErrorMessage}"
                       AutomationId="InvoiceDetailsPageLabelError"
                       TextColor="{StaticResource Error}"
                       HorizontalTextAlignment="Center" />
                <Button Text="Ponów"
                        AutomationId="InvoiceDetailsPageButtonRetry"
                        Command="{Binding LoadInvoiceCommand}"
                        HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Invoice details -->
            <VerticalStackLayout IsVisible="{Binding Invoice, Converter={StaticResource IsNotNullConverter}}"
                                 Spacing="0"
                                 Padding="0">

                <!-- Amount card -->
                <Border BackgroundColor="{StaticResource Primary}"
                        StrokeShape="RoundRectangle 0"
                        StrokeThickness="0"
                        Padding="20"
                        Margin="0">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="5">
                        <Label Text="{Binding Invoice.AmountGross, StringFormat='{0:N2}'}"
                               AutomationId="InvoiceDetailsPageLabelAmount"
                               FontSize="36"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextInverse}"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding Invoice.Currency}"
                               FontSize="18"
                               TextColor="{StaticResource TextInverse}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Vendor info -->
                <Border Margin="15,15,15,5" Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Sprzedawca" Style="{StaticResource LabelCaption}" />
                        <Label Text="{Binding Invoice.VendorName}"
                               AutomationId="InvoiceDetailsPageLabelVendorName"
                               FontSize="18" FontAttributes="Bold" />
                        <Label Text="{Binding Invoice.VendorNip, StringFormat='NIP: {0}'}"
                               FontSize="14" TextColor="{StaticResource TextMuted}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Dates -->
                <Border Margin="15,5" Style="{StaticResource CardBorder}">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                        <Label Text="Data wystawienia" Style="{StaticResource LabelCaption}" />
                        <Label Grid.Row="1"
                               Text="{Binding Invoice.IssueDate, StringFormat='{0:dd.MM.yyyy}'}"
                               FontSize="16" />
                        <Label Grid.Column="1" Text="Data nabycia" Style="{StaticResource LabelCaption}" />
                        <Label Grid.Row="1" Grid.Column="1"
                               Text="{Binding Invoice.AcquisitionDate, StringFormat='{0:dd.MM.yyyy}'}"
                               FontSize="16" />
                    </Grid>
                </Border>

                <!-- KSeF identifiers -->
                <Border Margin="15,5" Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Numer faktury" Style="{StaticResource LabelCaption}" />
                        <Label Text="{Binding Invoice.InvoiceNumber, TargetNullValue='---'}" FontSize="14" />
                        <Label Text="Numer KSeF" Style="{StaticResource LabelCaption}" />
                        <Label Text="{Binding Invoice.KSeFInvoiceNumber}" FontSize="14"
                               AutomationId="InvoiceDetailsPageLabelKsefNumber" />
                    </VerticalStackLayout>
                </Border>

                <!-- Invoice lines -->
                <Border Margin="15,5" Style="{StaticResource CardBorder}"
                        IsVisible="{Binding HasLines}">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="Pozycje faktury"
                               Style="{StaticResource LabelCaption}"
                               Margin="0,0,0,8" />
                        <VerticalStackLayout Spacing="4"
                                             BindableLayout.ItemsSource="{Binding Invoice.Lines}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:InvoiceLineDto">
                                    <Border BackgroundColor="{StaticResource Background}"
                                            StrokeShape="RoundRectangle 6"
                                            StrokeThickness="0"
                                            Padding="10">
                                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4">
                                            <!-- Line number + name -->
                                            <Label Grid.Column="0"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   Text="{Binding Name}"
                                                   LineBreakMode="WordWrap" />
                                            <Label Grid.Column="1"
                                                   FontSize="11"
                                                   TextColor="{StaticResource TextMuted}"
                                                   Text="{Binding LineNumber, StringFormat='#{0}'}"
                                                   HorizontalTextAlignment="End" />
                                            <!-- Quantity × unit -->
                                            <Label Grid.Row="1" Grid.ColumnSpan="2"
                                                   FontSize="12"
                                                   TextColor="{StaticResource TextMuted}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Quantity, StringFormat='{0:N4}'}" />
                                                        <Span Text=" " />
                                                        <Span Text="{Binding Unit}" />
                                                        <Span Text="  ×  " TextColor="{StaticResource TextMuted}" />
                                                        <Span Text="{Binding UnitPriceNet, StringFormat='{0:N2}'}" />
                                                        <Span Text=" netto" TextColor="{StaticResource TextMuted}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <!-- Amounts -->
                                            <Label Grid.Row="2" Grid.ColumnSpan="2"
                                                   FontSize="13"
                                                   FontAttributes="Bold">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Netto: " TextColor="{StaticResource TextMuted}" FontSize="11" />
                                                        <Span Text="{Binding AmountNet, StringFormat='{0:N2}'}" />
                                                        <Span Text="   Brutto: " TextColor="{StaticResource TextMuted}" FontSize="11" />
                                                        <Span Text="{Binding AmountGross, StringFormat='{0:N2}'}" />
                                                        <Span Text="   VAT: " TextColor="{StaticResource TextMuted}" FontSize="11" />
                                                        <Span Text="{Binding VatRate}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Action buttons -->
                <VerticalStackLayout Spacing="10" Padding="15,15,15,30">
                    <Button Text="Kopiuj dane przelewu"
                            AutomationId="InvoiceDetailsPageButtonCopyTransfer"
                            Command="{Binding CopyTransferDetailsCommand}"
                            HorizontalOptions="Fill" />
                    <Button Text="Pokaż kod QR"
                            AutomationId="InvoiceDetailsPageButtonShowQr"
                            Command="{Binding ShowQrCodeCommand}"
                            Style="{StaticResource ButtonSecondary}"
                            HorizontalOptions="Fill" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Grid>
    </ScrollView>

</ContentPage>
