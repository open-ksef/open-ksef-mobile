<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OpenKSeF.Mobile.ViewModels"
             x:Class="OpenKSeF.Mobile.Views.OnboardingPage"
             x:DataType="vm:OnboardingViewModel"
             Title="Konfiguracja"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource GradientStart}" Offset="0.0" />
            <GradientStop Color="{StaticResource GradientMid}" Offset="0.4" />
            <GradientStop Color="{StaticResource GradientEnd}" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView VerticalOptions="Center">
        <Frame Style="{StaticResource CardFrame}"
               Padding="28,32"
               Margin="24"
               HorizontalOptions="Fill"
               MaximumWidthRequest="400">

            <VerticalStackLayout Spacing="16">

                <HorizontalStackLayout HorizontalOptions="Center"
                                       Spacing="0"
                                       AutomationId="OnboardingStepIndicator"
                                       Margin="0,0,0,8">
                    <Frame WidthRequest="32" HeightRequest="32" CornerRadius="16"
                           Padding="0" HasShadow="False"
                           BackgroundColor="{Binding Step1Color}" BorderColor="Transparent">
                        <Label Text="{Binding Step1Label}" HorizontalOptions="Center"
                               VerticalOptions="Center" FontSize="14" FontFamily="InterBold"
                               TextColor="White" />
                    </Frame>
                    <BoxView WidthRequest="28" HeightRequest="2" Color="{AppThemeBinding Light={StaticResource UiBorder}, Dark={StaticResource UiBorderDark}}" VerticalOptions="Center" />
                    <Frame WidthRequest="32" HeightRequest="32" CornerRadius="16"
                           Padding="0" HasShadow="False"
                           BackgroundColor="{Binding Step2Color}" BorderColor="Transparent">
                        <Label Text="{Binding Step2Label}" HorizontalOptions="Center"
                               VerticalOptions="Center" FontSize="14" FontFamily="InterBold"
                               TextColor="White" />
                    </Frame>
                    <BoxView WidthRequest="28" HeightRequest="2" Color="{AppThemeBinding Light={StaticResource UiBorder}, Dark={StaticResource UiBorderDark}}" VerticalOptions="Center" />
                    <Frame WidthRequest="32" HeightRequest="32" CornerRadius="16"
                           Padding="0" HasShadow="False"
                           BackgroundColor="{Binding Step3Color}" BorderColor="Transparent">
                        <Label Text="{Binding Step3Label}" HorizontalOptions="Center"
                               VerticalOptions="Center" FontSize="14" FontFamily="InterBold"
                               TextColor="White" />
                    </Frame>
                </HorizontalStackLayout>

                <Label Text="{Binding StepTitle}"
                       FontSize="22" FontFamily="InterBold"
                       TextColor="{AppThemeBinding Light={StaticResource UiText}, Dark={StaticResource UiTextDark}}" HorizontalOptions="Center" />

                <Frame BackgroundColor="{AppThemeBinding Light={StaticResource UiErrorBg}, Dark={StaticResource UiErrorBgDark}}" CornerRadius="8" Padding="12" HasShadow="False"
                       BorderColor="Transparent"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}">
                    <Label Text="{Binding ErrorMessage}" TextColor="{AppThemeBinding Light={StaticResource UiError}, Dark={StaticResource UiErrorDark}}" FontSize="13"
                           HorizontalTextAlignment="Center" />
                </Frame>

                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsStep1}">
                    <Label Text="Podaj dane swojej firmy, aby rozpocząć korzystanie z KSeF."
                           FontSize="14" TextColor="{AppThemeBinding Light={StaticResource UiMuted}, Dark={StaticResource UiMutedDark}}" HorizontalTextAlignment="Center" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="NIP" Style="{StaticResource LabelFormLabel}" />
                        <Entry Text="{Binding Nip}" Placeholder="1234567890" Keyboard="Numeric" MaxLength="10"
                               AutomationId="OnboardingEntryNip" />
                        <Label Text="10-cyfrowy numer identyfikacji podatkowej" Style="{StaticResource LabelCaption}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource LabelFormLabel}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span FontFamily="Inter" Text="Nazwa wyświetlana " />
                                    <Span FontFamily="Inter" Text="(opcjonalnie)" TextColor="{AppThemeBinding Light={StaticResource UiMuted}, Dark={StaticResource UiMutedDark}}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Entry Text="{Binding DisplayName}" Placeholder="np. Acme Sp. z o.o."
                               AutomationId="OnboardingEntryDisplayName" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource LabelFormLabel}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span FontFamily="Inter" Text="E-mail do powiadomień " />
                                    <Span FontFamily="Inter" Text="(opcjonalnie)" TextColor="{AppThemeBinding Light={StaticResource UiMuted}, Dark={StaticResource UiMutedDark}}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Entry Text="{Binding NotificationEmail}" Placeholder="faktury@firma.pl" Keyboard="Email"
                               AutomationId="OnboardingEntryNotificationEmail" />
                    </VerticalStackLayout>

                    <Button Text="Dalej" AutomationId="OnboardingButtonNext"
                            Command="{Binding SubmitStep1Command}"
                            HorizontalOptions="Fill" Margin="0,8,0,0" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsStep2}">
                    <Label Text="Dodaj token autoryzacyjny KSeF, aby umożliwić synchronizację faktur."
                           FontSize="14" TextColor="{AppThemeBinding Light={StaticResource UiMuted}, Dark={StaticResource UiMutedDark}}" HorizontalTextAlignment="Center" />

                    <Frame BackgroundColor="{AppThemeBinding Light={StaticResource UiInfoBg}, Dark={StaticResource UiInfoBgDark}}" CornerRadius="8" Padding="12" HasShadow="False"
                           BorderColor="Transparent">
                        <Label FontSize="12" TextColor="{AppThemeBinding Light={StaticResource UiInfo}, Dark={StaticResource UiInfoDark}}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Jak uzyskać token KSeF:" FontFamily="InterBold" />
                                    <Span FontFamily="Inter" Text="&#10;1. Przejdź na ksef-test.mf.gov.pl" />
                                    <Span FontFamily="Inter" Text="&#10;2. Zaloguj się danymi firmy" />
                                    <Span FontFamily="Inter" Text="&#10;3. Sekcja Tokeny autoryzacyjne" />
                                    <Span FontFamily="Inter" Text="&#10;4. Wygeneruj token z uprawnieniami" />
                                    <Span FontFamily="Inter" Text="&#10;5. Skopiuj i wklej poniżej" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Frame>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Token KSeF" Style="{StaticResource LabelFormLabel}" />
                        <Editor Text="{Binding KsefToken}" Placeholder="Wklej token..."
                                HeightRequest="100" AutomationId="OnboardingEntryKsefToken" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,8,0,0">
                        <Label Text="Pomiń ten krok" AutomationId="OnboardingButtonSkipToken"
                               TextColor="{AppThemeBinding Light={StaticResource UiLink}, Dark={StaticResource UiLinkDark}}" FontSize="14" VerticalOptions="Center" TextDecorations="Underline">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SkipTokenCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Button Text="Dalej" Grid.Column="1" AutomationId="OnboardingButtonNext"
                                Command="{Binding SubmitStep2Command}"
                                HorizontalOptions="Fill" />
                    </Grid>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsStep3}">
                    <Label Text="✓" FontSize="48" TextColor="{AppThemeBinding Light={StaticResource UiSuccess}, Dark={StaticResource UiSuccessDark}}" HorizontalOptions="Center"
                           AutomationId="OnboardingLabelSuccess" />
                    <Label Text="{Binding SuccessMessage}" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource UiMuted}, Dark={StaticResource UiMutedDark}}"
                           HorizontalTextAlignment="Center" />
                    <ActivityIndicator IsRunning="{Binding IsSyncing}" IsVisible="{Binding IsSyncing}"
                                       HorizontalOptions="Center" />
                    <Label Text="{Binding SyncStatusText}" AutomationId="OnboardingLabelSyncStatus"
                           FontSize="13" TextColor="{AppThemeBinding Light={StaticResource UiMuted}, Dark={StaticResource UiMutedDark}}" HorizontalTextAlignment="Center"
                           IsVisible="{Binding SyncStatusText, Converter={StaticResource IsNotNullConverter}}" />
                    <Label Text="Token KSeF nie został dodany. Synchronizacja nie będzie działać do momentu dodania tokenu."
                           FontSize="13" TextColor="{AppThemeBinding Light={StaticResource UiWarning}, Dark={StaticResource UiWarningDark}}" HorizontalTextAlignment="Center"
                           IsVisible="{Binding TokenSkipped}" />
                    <Button Text="Przejdź do faktur" AutomationId="OnboardingButtonFinish"
                            Command="{Binding GoToInvoicesCommand}"
                            HorizontalOptions="Fill" Margin="0,8,0,0" />
                </VerticalStackLayout>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Frame>
    </ScrollView>

</ContentPage>
