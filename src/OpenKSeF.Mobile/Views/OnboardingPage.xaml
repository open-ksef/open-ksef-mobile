<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OpenKSeF.Mobile.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="OpenKSeF.Mobile.Views.OnboardingPage"
             x:DataType="vm:OnboardingViewModel"
             Title="Konfiguracja"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource GradientStart}" Offset="0.0" />
            <GradientStop Color="{StaticResource GradientMid}" Offset="0.4" />
            <GradientStop Color="{StaticResource GradientEnd}" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView VerticalOptions="Center">
        <Frame Style="{StaticResource CardFrame}"
               Padding="28,32"
               Margin="24"
               HorizontalOptions="Fill"
               MaximumWidthRequest="400">

            <VerticalStackLayout Spacing="16">

                <HorizontalStackLayout HorizontalOptions="Center"
                                       Spacing="0"
                                       AutomationId="OnboardingStepIndicator"
                                       Margin="0,0,0,8">
                    <Frame WidthRequest="32" HeightRequest="32" CornerRadius="16"
                           Padding="0" HasShadow="False"
                           BackgroundColor="{Binding Step1Color}" BorderColor="Transparent">
                        <Label Text="{Binding Step1Label}" HorizontalOptions="Center"
                               VerticalOptions="Center" FontSize="14" FontFamily="InterBold"
                               TextColor="White" />
                    </Frame>
                    <BoxView WidthRequest="28" HeightRequest="2" Color="{AppThemeBinding Light={StaticResource UiBorder}, Dark={StaticResource UiBorderDark}}" VerticalOptions="Center" />
                    <Frame WidthRequest="32" HeightRequest="32" CornerRadius="16"
                           Padding="0" HasShadow="False"
                           BackgroundColor="{Binding Step2Color}" BorderColor="Transparent">
                        <Label Text="{Binding Step2Label}" HorizontalOptions="Center"
                               VerticalOptions="Center" FontSize="14" FontFamily="InterBold"
                               TextColor="White" />
                    </Frame>
                    <BoxView WidthRequest="28" HeightRequest="2" Color="{AppThemeBinding Light={StaticResource UiBorder}, Dark={StaticResource UiBorderDark}}" VerticalOptions="Center" />
                    <Frame WidthRequest="32" HeightRequest="32" CornerRadius="16"
                           Padding="0" HasShadow="False"
                           BackgroundColor="{Binding Step3Color}" BorderColor="Transparent">
                        <Label Text="{Binding Step3Label}" HorizontalOptions="Center"
                               VerticalOptions="Center" FontSize="14" FontFamily="InterBold"
                               TextColor="White" />
                    </Frame>
                </HorizontalStackLayout>

                <Label Text="{Binding StepTitle}"
                       FontSize="22" FontFamily="InterBold"
                       TextColor="{AppThemeBinding Light={StaticResource UiText}, Dark={StaticResource UiTextDark}}" HorizontalOptions="Center" />

                <Frame BackgroundColor="{AppThemeBinding Light={StaticResource UiErrorBg}, Dark={StaticResource UiErrorBgDark}}" CornerRadius="8" Padding="12" HasShadow="False"
                       BorderColor="Transparent"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}">
                    <Label Text="{Binding ErrorMessage}" TextColor="{AppThemeBinding Light={StaticResource UiError}, Dark={StaticResource UiErrorDark}}" FontSize="13"
                           HorizontalTextAlignment="Center" />
                </Frame>

                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsStep1}">
                    <Label Text="Podaj dane swojej firmy, aby rozpocząć korzystanie z KSeF."
                           FontSize="14" TextColor="{AppThemeBinding Light={StaticResource UiMuted}, Dark={StaticResource UiMutedDark}}" HorizontalTextAlignment="Center" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="NIP" Style="{StaticResource LabelFormLabel}" />
                        <Entry Text="{Binding Nip}" Placeholder="1234567890" Keyboard="Numeric" MaxLength="10"
                               AutomationId="OnboardingEntryNip" />
                        <Label Text="10-cyfrowy numer identyfikacji podatkowej" Style="{StaticResource LabelCaption}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource LabelFormLabel}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span FontFamily="Inter" Text="Nazwa wyświetlana " />
                                    <Span FontFamily="Inter" Text="(opcjonalnie)" TextColor="{AppThemeBinding Light={StaticResource UiMuted}, Dark={StaticResource UiMutedDark}}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Entry Text="{Binding DisplayName}" Placeholder="np. Acme Sp. z o.o."
                               AutomationId="OnboardingEntryDisplayName" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource LabelFormLabel}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span FontFamily="Inter" Text="E-mail do powiadomień " />
                                    <Span FontFamily="Inter" Text="(opcjonalnie)" TextColor="{AppThemeBinding Light={StaticResource UiMuted}, Dark={StaticResource UiMutedDark}}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Entry Text="{Binding NotificationEmail}" Placeholder="faktury@firma.pl" Keyboard="Email"
                               AutomationId="OnboardingEntryNotificationEmail" />
                        <Label Text="E-mail wysyłamy tylko wtedy, gdy administrator serwera skonfigurował pocztę."
                               AutomationId="OnboardingLabelNotificationEmailHint"
                               Style="{StaticResource LabelCaption}" />
                    </VerticalStackLayout>

                    <Button Text="Dalej" AutomationId="OnboardingButtonNext"
                            Command="{Binding SubmitStep1Command}"
                            HorizontalOptions="Fill" Margin="0,8,0,0" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsStep2}">
                    <Label Text="Dodaj token KSeF, aby pobierać i wystawiać faktury."
                           FontSize="14" TextColor="{AppThemeBinding Light={StaticResource UiMuted}, Dark={StaticResource UiMutedDark}}" HorizontalTextAlignment="Center" />

                    <Border Style="{StaticResource UiAlert}" AutomationId="OnboardingCardTokenPermissions"
                            BackgroundColor="{AppThemeBinding Light={StaticResource UiSurface2}, Dark={StaticResource UiSurface2Dark}}">
                        <VerticalStackLayout Spacing="12">
                            <!-- AppThemeBinding on a Behavior never re-evaluates, so the icon tints bind to this element. -->
                            <BoxView x:Name="PrimaryInk" IsVisible="False" Color="{AppThemeBinding Light={StaticResource UiPrimary}, Dark={StaticResource UiPrimaryDark}}" />
                            <Label Text="Uprawnienia tokenu" FontSize="16" FontFamily="InterSemiBold" SemanticProperties.HeadingLevel="Level2"
                                   TextColor="{AppThemeBinding Light={StaticResource UiText}, Dark={StaticResource UiTextDark}}" />
                            <Grid ColumnDefinitions="32,*" ColumnSpacing="12" AutomationId="OnboardingRowPermissionRead">
                                <Border WidthRequest="32" HeightRequest="32" StrokeThickness="0" StrokeShape="RoundRectangle 16" VerticalOptions="Start"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource UiPrimarySubtle}, Dark={StaticResource UiPrimarySubtleDark}}">
                                    <Image Source="tab_invoices.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Image.Behaviors>
                                            <toolkit:IconTintColorBehavior x:DataType="BoxView" TintColor="{Binding Color, Source={x:Reference PrimaryInk}}" />
                                        </Image.Behaviors>
                                    </Image>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Przeglądanie faktur" FontSize="14" FontFamily="InterSemiBold"
                                           TextColor="{AppThemeBinding Light={StaticResource UiText}, Dark={StaticResource UiTextDark}}" />
                                    <Label Text="Pobieramy faktury otrzymane i powiadamiamy o nowych." Style="{StaticResource UiMutedText}" />
                                </VerticalStackLayout>
                            </Grid>
                            <Grid ColumnDefinitions="32,*" ColumnSpacing="12" AutomationId="OnboardingRowPermissionWrite">
                                <Border WidthRequest="32" HeightRequest="32" StrokeThickness="0" StrokeShape="RoundRectangle 16" VerticalOptions="Start"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource UiPrimarySubtle}, Dark={StaticResource UiPrimarySubtleDark}}">
                                    <Image Source="icon_send.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Image.Behaviors>
                                            <toolkit:IconTintColorBehavior x:DataType="BoxView" TintColor="{Binding Color, Source={x:Reference PrimaryInk}}" />
                                        </Image.Behaviors>
                                    </Image>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Wystawianie faktur" FontSize="14" FontFamily="InterSemiBold"
                                           TextColor="{AppThemeBinding Light={StaticResource UiText}, Dark={StaticResource UiTextDark}}" />
                                    <Label Text="Wysyłamy Twoje faktury do KSeF. Bez tego uprawnienia tylko odbierasz." Style="{StaticResource UiMutedText}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Frame BackgroundColor="{AppThemeBinding Light={StaticResource UiInfoBg}, Dark={StaticResource UiInfoBgDark}}" CornerRadius="8" Padding="12" HasShadow="False"
                           BorderColor="Transparent">
                        <VerticalStackLayout Spacing="8">
                            <Label FontSize="12" TextColor="{AppThemeBinding Light={StaticResource UiInfo}, Dark={StaticResource UiInfoDark}}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Jak uzyskać token KSeF:" FontFamily="InterBold" />
                                        <Span FontFamily="Inter" Text="&#10;1. Otwórz Aplikację Podatnika KSeF 2.0" />
                                        <Span FontFamily="Inter" Text="&#10;2. Zaloguj się jako firma lub osoba z uprawnieniami" />
                                        <Span FontFamily="Inter" Text="&#10;3. Wygeneruj token z uprawnieniami: Przeglądanie faktur i Wystawianie faktur." />
                                        <Span FontFamily="Inter" Text="&#10;4. Skopiuj token od razu i wklej poniżej" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Text="Instrukcja krok po kroku" FontSize="12" FontFamily="InterBold" TextDecorations="Underline"
                                   TextColor="{AppThemeBinding Light={StaticResource UiLink}, Dark={StaticResource UiLinkDark}}"
                                   MinimumHeightRequest="44" VerticalTextAlignment="Center"
                                   AutomationId="OnboardingLinkTokenDocs"
                                   SemanticProperties.Description="Instrukcja krok po kroku: jak uzyskać token KSeF"
                                   SemanticProperties.Hint="Otwiera stronę w przeglądarce">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenTokenDocsCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </VerticalStackLayout>
                    </Frame>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Token KSeF" Style="{StaticResource LabelFormLabel}" />
                        <Editor Text="{Binding KsefToken}" Placeholder="Wklej token..."
                                HeightRequest="100" AutomationId="OnboardingEntryKsefToken" />
                        <Label Text="Token z uprawnieniami Przeglądanie faktur i Wystawianie faktur, z Aplikacji Podatnika KSeF. Bez uprawnienia Wystawianie faktur tylko odbierasz."
                               Style="{StaticResource LabelCaption}" AutomationId="OnboardingLabelTokenHint" />
                        <Label Text="{Binding TokenError}" Style="{StaticResource UiFieldError}" AutomationId="OnboardingLabelTokenError"
                               IsVisible="{Binding TokenError, Converter={StaticResource IsNotNullConverter}}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,8,0,0">
                        <Label Text="Pomiń ten krok" AutomationId="OnboardingButtonSkipToken"
                               TextColor="{AppThemeBinding Light={StaticResource UiLink}, Dark={StaticResource UiLinkDark}}" FontSize="14" VerticalOptions="Center" TextDecorations="Underline">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SkipTokenCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Button Text="Dalej" Grid.Column="1" AutomationId="OnboardingButtonNext"
                                Command="{Binding SubmitStep2Command}"
                                HorizontalOptions="Fill" />
                    </Grid>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsStep3}">
                    <Label Text="✓" FontSize="48" TextColor="{AppThemeBinding Light={StaticResource UiSuccess}, Dark={StaticResource UiSuccessDark}}" HorizontalOptions="Center"
                           AutomationId="OnboardingLabelSuccess" />
                    <Label Text="{Binding SuccessMessage}" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource UiMuted}, Dark={StaticResource UiMutedDark}}"
                           HorizontalTextAlignment="Center" />
                    <ActivityIndicator IsRunning="{Binding IsSyncing}" IsVisible="{Binding IsSyncing}"
                                       HorizontalOptions="Center" />
                    <Label Text="{Binding SyncStatusText}" AutomationId="OnboardingLabelSyncStatus"
                           FontSize="13" TextColor="{AppThemeBinding Light={StaticResource UiMuted}, Dark={StaticResource UiMutedDark}}" HorizontalTextAlignment="Center"
                           IsVisible="{Binding SyncStatusText, Converter={StaticResource IsNotNullConverter}}" />
                    <Label Text="Token KSeF nie został dodany. Synchronizacja nie będzie działać do momentu dodania tokenu."
                           FontSize="13" TextColor="{AppThemeBinding Light={StaticResource UiWarning}, Dark={StaticResource UiWarningDark}}" HorizontalTextAlignment="Center"
                           IsVisible="{Binding TokenSkipped}" />
                    <Button Text="Przejdź do faktur" AutomationId="OnboardingButtonFinish"
                            Command="{Binding GoToInvoicesCommand}"
                            HorizontalOptions="Fill" Margin="0,8,0,0" />
                </VerticalStackLayout>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Frame>
    </ScrollView>

</ContentPage>
