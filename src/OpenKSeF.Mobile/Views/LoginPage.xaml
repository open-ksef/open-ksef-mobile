<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OpenKSeF.Mobile.ViewModels"
             x:Class="OpenKSeF.Mobile.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Logowanie"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource GradientStart}" Offset="0.0" />
            <GradientStop Color="{StaticResource GradientMid}" Offset="0.4" />
            <GradientStop Color="{StaticResource GradientEnd}" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid SafeAreaEdges="Container, Container, Container, SoftInput">
    <ActivityIndicator IsRunning="{Binding IsRestoringSession}" IsVisible="{Binding IsRestoringSession}"
                       Color="White" VerticalOptions="Center" HorizontalOptions="Center"
                       AutomationId="LoginPageIndicatorRestoring" />
    <ScrollView x:Name="Scroll"
                SizeChanged="OnScrollSizeChanged"
                VerticalOptions="Center"
                IsVisible="{Binding IsRestoringSession, Converter={StaticResource InvertedBoolConverter}}">
        <Border BackgroundColor="{AppThemeBinding Light={StaticResource UiSurface}, Dark={StaticResource UiSurfaceDark}}"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="0"
                Padding="28,36"
                Margin="20"
                HorizontalOptions="Fill"
                MaximumWidthRequest="400">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.25" Radius="12" Offset="0,4" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="12">

                <Label Text="⚡"
                       FontSize="40"
                       HorizontalOptions="Center"
                       AutomationId="LoginPageLabelLogo" />
                <Label Text="OpenKSeF"
                       AutomationId="LoginPageLabelTitle"
                       FontSize="28"
                       FontFamily="InterBold"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource UiText}, Dark={StaticResource UiTextDark}}" />
                <Label Text="{Binding SubtitleText}"
                       FontSize="14"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource UiMuted}, Dark={StaticResource UiMutedDark}}"
                       Margin="0,0,0,8" />

                <Border BackgroundColor="{AppThemeBinding Light={StaticResource UiErrorBg}, Dark={StaticResource UiErrorBgDark}}"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="0"
                        Padding="12"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}">
                    <Label Text="{Binding ErrorMessage}"
                           AutomationId="LoginPageLabelError"
                           TextColor="{AppThemeBinding Light={StaticResource UiError}, Dark={StaticResource UiErrorDark}}"
                           FontSize="13"
                           HorizontalTextAlignment="Center" />
                </Border>

                <VerticalStackLayout Spacing="10"
                                     IsVisible="{Binding IsBrowserLogin, Converter={StaticResource InvertedBoolConverter}}">
                    <VerticalStackLayout Spacing="10"
                                         IsVisible="{Binding IsLoginMode}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Email" Style="{StaticResource LabelFormLabel}" />
                            <Entry Text="{Binding Email}"
                                   Placeholder="jan@firma.pl"
                                   Keyboard="Email"
                                   AutomationId="LoginPageEntryEmail"
                                   Focused="OnLoginFieldFocused" Unfocused="OnFieldUnfocused"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Hasło" Style="{StaticResource LabelFormLabel}" />
                            <Entry Text="{Binding Password}"
                                   Placeholder="••••••••"
                                   IsPassword="True"
                                   AutomationId="LoginPageEntryPassword"
                                   Focused="OnLoginFieldFocused" Unfocused="OnFieldUnfocused"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                        </VerticalStackLayout>

                        <Button Text="{Binding LoginButtonText}"
                                x:Name="LoginButton"
                                AutomationId="LoginPageButtonLogin"
                                Command="{Binding LoginWithCredentialsCommand}"
                                HorizontalOptions="Fill"
                                Margin="0,8,0,0" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10"
                                         IsVisible="{Binding IsLoginMode, Converter={StaticResource InvertedBoolConverter}}">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Imię" Style="{StaticResource LabelFormLabel}" />
                                <Entry Text="{Binding RegFirstName}"
                                       Placeholder="Jan"
                                       AutomationId="LoginPageEntryRegFirstName"
                                       Focused="OnRegisterFieldFocused" Unfocused="OnFieldUnfocused"
                                       IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4" Grid.Column="1">
                                <Label Text="Nazwisko" Style="{StaticResource LabelFormLabel}" />
                                <Entry Text="{Binding RegLastName}"
                                       Placeholder="Kowalski"
                                       AutomationId="LoginPageEntryRegLastName"
                                       Focused="OnRegisterFieldFocused" Unfocused="OnFieldUnfocused"
                                       IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Email" Style="{StaticResource LabelFormLabel}" />
                            <Entry Text="{Binding RegEmail}"
                                   Placeholder="jan@firma.pl"
                                   Keyboard="Email"
                                   AutomationId="LoginPageEntryRegEmail"
                                   Focused="OnRegisterFieldFocused" Unfocused="OnFieldUnfocused"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Hasło" Style="{StaticResource LabelFormLabel}" />
                            <Entry Text="{Binding RegPassword}"
                                   Placeholder="Min. 8 znaków"
                                   IsPassword="True"
                                   AutomationId="LoginPageEntryRegPassword"
                                   Focused="OnRegisterFieldFocused" Unfocused="OnFieldUnfocused"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Powtórz hasło" Style="{StaticResource LabelFormLabel}" />
                            <Entry Text="{Binding RegConfirmPassword}"
                                   Placeholder="Powtórz hasło"
                                   IsPassword="True"
                                   AutomationId="LoginPageEntryRegConfirmPassword"
                                   Focused="OnRegisterFieldFocused" Unfocused="OnFieldUnfocused"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                        </VerticalStackLayout>

                        <Button Text="{Binding RegisterButtonText}"
                                x:Name="RegisterButton"
                                AutomationId="LoginPageButtonRegister"
                                Command="{Binding RegisterCommand}"
                                HorizontalOptions="Fill"
                                Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10"
                                     IsVisible="{Binding IsBrowserLogin}">
                    <Button Text="{Binding LoginButtonText}"
                            AutomationId="LoginPageButtonLoginInBrowser"
                            Command="{Binding LoginInBrowserCommand}"
                            HorizontalOptions="Fill"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

                    <Button Text="Załóż konto"
                            AutomationId="LoginPageButtonRegisterInBrowser"
                            IsVisible="{Binding IsRegistrationAllowed}"
                            Command="{Binding RegisterInBrowserCommand}"
                            Style="{StaticResource ButtonOutline}"
                            HorizontalOptions="Fill"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,Auto,*" Margin="0,4">
                    <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource UiBorder}, Dark={StaticResource UiBorderDark}}" VerticalOptions="Center" />
                    <Label Text="lub" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource UiMuted}, Dark={StaticResource UiMutedDark}}" Margin="12,0" Grid.Column="1" />
                    <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource UiBorder}, Dark={StaticResource UiBorderDark}}" VerticalOptions="Center" Grid.Column="2" />
                </Grid>

                <Button Text="Sparuj z portalem"
                        AutomationId="LoginPageButtonPair"
                        IsVisible="{Binding IsBrowserLogin}"
                        Command="{Binding PairCommand}"
                        Style="{StaticResource ButtonOutline}"
                        HorizontalOptions="Fill"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

                <Button Text="Zaloguj przez Google"
                        AutomationId="LoginPageButtonGoogle"
                        Command="{Binding LoginWithGoogleCommand}"
                        Style="{StaticResource ButtonOutline}"
                        HorizontalOptions="Fill"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

                <VerticalStackLayout IsVisible="{Binding IsBrowserLogin, Converter={StaticResource InvertedBoolConverter}}">
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,8,0,0"
                                           IsVisible="{Binding IsRegistrationAllowed}">
                        <Label Text="{Binding SwitchPromptText}"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource UiMuted}, Dark={StaticResource UiMutedDark}}"
                               VerticalOptions="Center" />
                        <Label AutomationId="{Binding SwitchButtonAutomationId}"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource UiLink}, Dark={StaticResource UiLinkDark}}"
                               FontFamily="InterBold"
                               VerticalOptions="Center">
                            <Label.Text>
                                <Binding Path="SwitchLinkText" />
                            </Label.Text>
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleModeCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   AutomationId="LoginPageActivityIndicatorBusy"
                                   IsVisible="{Binding IsBusy}"
                                   HorizontalOptions="Center" />

                <VerticalStackLayout Spacing="6" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource UiMuted}, Dark={StaticResource UiMutedDark}}"
                               VerticalOptions="Center"
                               LineBreakMode="MiddleTruncation"
                               IsVisible="{Binding HasActiveServerHost}"
                               AutomationId="LoginPageLabelServerHost">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span FontFamily="Inter" Text="Serwer: " />
                                    <Span Text="{Binding ActiveServerHost}" FontFamily="InterBold" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label Grid.Column="1"
                               Text="Zmień serwer"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource UiLink}, Dark={StaticResource UiLinkDark}}"
                               FontFamily="InterBold"
                               VerticalOptions="Center"
                               AutomationId="LoginPageButtonChangeServer">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleServerCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding IsServerVisible}">
                        <Entry Text="{Binding ServerUrl}"
                               Placeholder="https://faktury.twoja-firma.pl"
                               Keyboard="Url"
                               FontSize="12"
                               AutomationId="LoginPageEntryServerUrl"
                               Focused="OnServerFieldFocused" Unfocused="OnFieldUnfocused" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <Button Text="Zapisz"
                                    x:Name="SaveServerButton"
                                    AutomationId="LoginPageButtonSaveServer"
                                    Command="{Binding SaveServerCommand}"
                                    Style="{StaticResource ButtonSmall}" />
                            <Button Text="QR"
                                    AutomationId="LoginPageButtonScanQr"
                                    Command="{Binding ScanQrCommand}"
                                    Style="{StaticResource ButtonSecondary}"
                                    HeightRequest="36"
                                    FontSize="12"
                                    CornerRadius="8"
                                    Grid.Column="1" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Border>
    </ScrollView>
    </Grid>

</ContentPage>
