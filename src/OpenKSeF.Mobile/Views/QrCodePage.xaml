<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OpenKSeF.Mobile.ViewModels"
             x:Class="OpenKSeF.Mobile.Views.QrCodePage"
             x:DataType="vm:QrCodeViewModel"
             Title="Kod QR przelewu">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20" HorizontalOptions="Center">

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />

            <VerticalStackLayout IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                                 Spacing="10">
                <Label Text="{Binding ErrorMessage}"
                       AutomationId="QrCodePageLabelError"
                       TextColor="{AppThemeBinding Light={StaticResource UiError}, Dark={StaticResource UiErrorDark}}"
                       HorizontalTextAlignment="Center" />
                <Button Text="Ponów"
                        AutomationId="QrCodePageButtonRetry"
                        Command="{Binding GenerateQrCommand}"
                        HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Label Text="{Binding Title}"
                   IsVisible="{Binding Title, Converter={StaticResource IsNotNullConverter}}"
                   AutomationId="QrCodePageLabelTitle"
                   FontSize="18"
                   FontFamily="InterBold"
                   HorizontalTextAlignment="Center" />

            <Label Text="{Binding QrMessage}"
                   IsVisible="{Binding QrMessage, Converter={StaticResource IsNotNullConverter}}"
                   AutomationId="QrCodePageLabelMessage"
                   FontFamily="InterBold"
                   HorizontalTextAlignment="Center" />

            <VerticalStackLayout IsVisible="{Binding QrImage, Converter={StaticResource IsNotNullConverter}}"
                                 Spacing="20"
                                 HorizontalOptions="Center">

                <!-- Literal white in dark too: a themed surface breaks bank scanning. -->
                <Border Padding="15"
                        StrokeShape="RoundRectangle 12,12,12,12"
                        Stroke="{AppThemeBinding Light={StaticResource UiBorder}, Dark={StaticResource UiBorderDark}}"
                        BackgroundColor="White"
                        HorizontalOptions="Center">
                    <Image Source="{Binding QrImage}"
                           AutomationId="QrCodePageImageQr"
                           WidthRequest="300"
                           HeightRequest="300"
                           Aspect="AspectFit" />
                </Border>

                <Label Text="Zeskanuj kod w aplikacji banku, aby wypełnić przelew. Na tym telefonie: udostępnij i zapisz obraz, a w banku wczytaj kod z galerii."
                       Style="{StaticResource LabelMuted}"
                       HorizontalTextAlignment="Center" />

                <Button Text="Udostępnij / zapisz kod QR"
                        AutomationId="QrCodePageButtonShare"
                        Command="{Binding ShareQrCommand}"
                        HorizontalOptions="Fill" />
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding ShowTransferText}"
                                 Spacing="20">
                <Label Text="{Binding TransferText}"
                       AutomationId="QrCodePageLabelTransferText" />
                <Button Text="Kopiuj dane przelewu"
                        AutomationId="QrCodePageButtonCopy"
                        Command="{Binding CopyTransferTextCommand}"
                        HorizontalOptions="Fill" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
